[TEMPLATE]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
RORISK_USER_SECRET=
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=

# NOWPayments: every crypto deposit and withdrawal goes through this account.
# API key: Dashboard -> Settings -> API keys (payments permission is enough;
# payouts are sent manually, so no payout/2FA credentials belong on the server).
NOWPAYMENTS_API_KEY=
# Dashboard -> Store settings -> IPN secret. Verifies every payment callback.
NOWPAYMENTS_IPN_SECRET=
# Public HTTPS origin NOWPayments can reach, e.g. https://rowild.lol
# Leave empty to infer it from the forwarded request host (never works on localhost).
NOWPAYMENTS_IPN_BASE_URL=

# Cosmetic Live Bets activity. Set to "off" to show only real bets.
LIVE_BETS_SIMULATION=
